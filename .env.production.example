# =============================================================================
# PRODUCTION environment — Northern TILE Distributors
# =============================================================================
# Copy to  <base>/shared/.env  on the server and fill in real values.
# NEVER commit the filled-in version. NEVER ship it in a deploy artifact.
# chmod 600 it so other shared-hosting users cannot read your credentials.
# =============================================================================

APP_NAME="Northern TILE Distributors"

# MUST be "production". Controls debug output, error detail and optimisations.
APP_ENV=production

# ---------------------------------------------------------------------------
# APP_KEY — encrypts sessions, cookies and any encrypted columns.
#
#   * Brand-new install : php artisan key:generate --force
#   * Existing site     : copy the EXISTING key across verbatim.
#
# Changing this key on a site that already has data logs every user out and
# makes existing encrypted values permanently unreadable. Treat it as
# irreplaceable and keep an offline copy.
# ---------------------------------------------------------------------------
APP_KEY=

# MUST be false in production. `true` leaks source, env vars and DB
# credentials on every error page.
APP_DEBUG=false

APP_URL=https://ntiled.com.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging — "debug" writes request payloads to disk and fills the quota.
# `daily` rotates so a single log file cannot grow without bound.
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# Database — from hPanel -> Databases -> MySQL.
# Use a dedicated user scoped to this one database, never the server root user.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions — database driver keeps logins working across PHP workers.
# SESSION_SECURE_COOKIE=true stops the session cookie ever being sent over
# plain HTTP. Requires a working certificate, so set it AFTER SSL is live.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ntiled.com.au
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail — Hostinger SMTP. Create the mailbox in hPanel first.
# Port 465 = implicit TLS, so MAIL_SCHEME must be "smtps".
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Asset path layout — MUST match how the build was produced.
#
#   false (recommended) : document root points at <base>/current/public
#                         Assets are served from /build/*
#   true  (legacy)      : document root is the application root
#                         Assets are served from /public/build/*
#
# The Vite build reads VITE_LEGACY_PUBLIC_PREFIX at BUILD time and the app
# reads LEGACY_PUBLIC_PREFIX at RUNTIME. If the two disagree every stylesheet
# and script 404s, so keep them identical.
# ---------------------------------------------------------------------------
LEGACY_PUBLIC_PREFIX=false
VITE_LEGACY_PUBLIC_PREFIX=false

VITE_APP_NAME="${APP_NAME}"
VITE_TRUSTPILOT_BUSINESS_UNIT_ID=
VITE_TRUSTPILOT_REVIEW_URL=

UI_TOPBAR_ENABLED=true
UI_TOPBAR_BG="#085a9c"
UI_TOPBAR_TEXT_COLOR="#ffffff"
UI_TOPBAR_MESSAGE="Melbourne's wholesale tile & flooring specialists · Visit us in Thomastown"
UI_TOPBAR_LINK_LABEL="Contact"
UI_TOPBAR_LINK_ROUTE="pages.contact"

# Server-side Google API key. Restrict it by API and by server IP in the
# Google Cloud console — an unrestricted key can be billed by anyone.
GOOGLE_API_KEY=

# AWS / S3 — only needed if you move uploads off local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
